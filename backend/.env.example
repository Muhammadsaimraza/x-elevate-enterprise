# Database — PostgreSQL is the production/default option.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/xelevate
# SQLite local-development alternative (no PostgreSQL/Docker needed).
# Relative SQLite paths are resolved against the backend/ directory,
# regardless of the working directory the server is started from.
# DATABASE_URL=sqlite+aiosqlite:///./xelevate.db

# Auth cookie transport security: set to true when the API is served over
# HTTPS (production); keep false for local plain-HTTP development
# (http://localhost), otherwise browsers would drop the login cookie.
COOKIE_SECURE=false

SECRET_KEY=your-secret-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Social account credentials (X / LinkedIn)
#
# Per-user account tokens (X auth token + handle, LinkedIn "li_at" session
# cookie + profile URL) are NOT configured here — they are stored per user
# in the database (users table) and managed at runtime via the authenticated
# settings API:
#
#   GET /api/settings/linked-accounts   → connection status (never returns tokens)
#   PUT /api/settings/linked-accounts   → save / clear a user's tokens
#
# The variables below are optional app-level API keys (OAuth consumer
# credentials). When set, they flip the matching service from "demo" to
# "configured" in /api/health; leave them out for local development.
# ─────────────────────────────────────────────────────────────────────────────
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Gemini AI — optional, enables AI features when provided.
GEMINI_API_KEY=your-gemini-api-key
CORS_ORIGINS=http://localhost:3000
